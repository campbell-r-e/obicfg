#!/usr/bin/env python3
"""Run obicfg straight from a checkout, with nothing installed.

Copy this repository onto the machine that can reach the ATA -- a router, a
NAS, an old netbook running Alpine -- and run ``./bin/obicfg`` with the system
Python. No pip, no virtualenv, no compiler.
"""

import os
import sys

sys.path.insert(
    0, os.path.join(os.path.dirname(os.path.abspath(__file__)), os.pardir, "src")
)

from obicfg.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
